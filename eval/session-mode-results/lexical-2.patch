+/** Validate and extract the mode from a raw pij-mode custom entry data value. */
+function parsePijModeData(data: unknown): DecisionMode | undefined {
+  if (data === null || typeof data !== "object" || Array.isArray(data)) return undefined;
+  const d = data as Record<string, unknown>;
+  const keys = Object.keys(d);
+  if (keys.length !== 2 || !Object.prototype.hasOwnProperty.call(d, "version") || !Object.prototype.hasOwnProperty.call(d, "mode")) return undefined;
+  if (d.version !== 1) return undefined;
+  if (d.mode !== "assist" && d.mode !== "observe" && d.mode !== "off") return undefined;
+  return d.mode as DecisionMode;
+}
+
+/** Walk the active branch backward (leaf → root) and return the most recent valid pij-mode selection.
+ *  getBranch() returns entries oldest-first (root → leaf), so we iterate in reverse. */
+function readModeFromBranch(manager: ExtensionContext["sessionManager"], fallback: DecisionMode): DecisionMode {
+  const branch = manager.getBranch(); // root → leaf (oldest first)
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const entry = branch[i]!;
+    if (entry.type !== "custom" || entry.customType !== "pij-mode") continue;
+    const parsed = parsePijModeData(entry.data);
+    if (parsed !== undefined) return parsed;
+    // Invalid record — keep searching backward for an older valid selection.
+  }
+  return fallback;
+}
