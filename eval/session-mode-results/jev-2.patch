+const PIJ_MODE_CUSTOM_TYPE = "pij-mode";
+
+interface PijModeData {
+  version: 1;
+  mode: DecisionMode;
+}
+
+/** Scan the active branch (newest-first) for the most recent valid pij-mode entry. */
+function readModeFromBranch(sessionManager: ExtensionContext["sessionManager"]): DecisionMode | undefined {
+  const branch = sessionManager.getBranch();
+  for (const entry of branch) {
+    if (entry.type !== "custom" || entry.customType !== PIJ_MODE_CUSTOM_TYPE) continue;
+    const data = entry.data as unknown;
+    if (
+      data !== null &&
+      typeof data === "object" &&
+      !Array.isArray(data) &&
+      Object.keys(data as object).length === 2 &&
+      (data as Record<string, unknown>)["version"] === 1 &&
+      ((data as Record<string, unknown>)["mode"] === "assist" ||
+        (data as Record<string, unknown>)["mode"] === "observe" ||
+        (data as Record<string, unknown>)["mode"] === "off")
+    ) {
+      return (data as PijModeData).mode;
+    }
+  }
+  return undefined;
+}
 
