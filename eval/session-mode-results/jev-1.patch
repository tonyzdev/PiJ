+const PIJ_MODE_CUSTOM_TYPE = "pij-mode";
+
+interface PijModeData {
+  version: 1;
+  mode: DecisionMode;
+}
+
+/**
+ * Validate a pij-mode custom entry's data. Returns the mode if valid, undefined otherwise.
+ * Rejects entries with unknown versions, extra fields, unknown modes, or malformed data.
+ */
+function validatePijModeData(data: unknown): DecisionMode | undefined {
+  if (data === null || typeof data !== "object" || Array.isArray(data)) return undefined;
+  const d = data as Record<string, unknown>;
+  const keys = Object.keys(d);
+  if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) return undefined;
+  if (d["version"] !== 1) return undefined;
+  const m = d["mode"];
+  if (m !== "assist" && m !== "observe" && m !== "off") return undefined;
+  return m as DecisionMode;
+}
+
+/**
+ * Search the active branch (root-to-leaf order) for the most recent valid pij-mode entry.
+ * Returns the configured default when no valid entry is found.
+ */
+function readModeFromBranch(
+  sessionManager: Pick<ExtensionContext["sessionManager"], "getBranch">,
+  defaultMode: DecisionMode,
+): DecisionMode {
+  const branch = sessionManager.getBranch();
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const entry = branch[i];
+    if (!entry || entry.type !== "custom") continue;
+    const custom = entry as CustomEntry;
+    if (custom.customType !== PIJ_MODE_CUSTOM_TYPE) continue;
+    const mode = validatePijModeData(custom.data);
+    if (mode !== undefined) return mode;
+  }
+  return defaultMode;
+}
