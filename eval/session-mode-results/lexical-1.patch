+/** Read the most recent valid pij-mode custom entry from the active branch. Exported for testing. */
+export function readModeFromBranch(sessionManager: ExtensionContext["sessionManager"]): DecisionMode | undefined {
+  const branch = sessionManager.getBranch(); // root-to-leaf order
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const entry = branch[i];
+    if (!entry) continue;
+    if (entry.type !== "custom" || entry.customType !== "pij-mode") continue;
+    const d = entry.data;
+    if (!d || typeof d !== "object" || Array.isArray(d)) continue;
+    const rec = d as Record<string, unknown>;
+    const keys = Object.keys(rec);
+    // Require exactly { version, mode } – additional fields are invalid
+    if (keys.length !== 2 || !("version" in rec) || !("mode" in rec)) continue;
+    if (rec["version"] !== 1) continue;
+    if (rec["mode"] !== "assist" && rec["mode"] !== "observe" && rec["mode"] !== "off") continue;
+    return rec["mode"] as DecisionMode;
+  }
+  return undefined;
+}
