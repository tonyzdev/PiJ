diff --git a/test/session-mode-persistence.test.ts b/test/session-mode-persistence.test.ts
new file mode 100644
index 0000000..17816e5
--- /dev/null
+++ b/test/session-mode-persistence.test.ts
@@ -0,0 +1,150 @@
+/**
+ * Unit tests for pij-mode session-native persistence.
+ *
+ * These tests exercise readModeFromBranch directly and through the extension
+ * handler lifecycle, verifying:
+ *   - Valid entries are restored correctly
+ *   - Invalid entries (malformed data, extra fields, unknown mode, bad version) are skipped
+ *   - The most recent valid entry wins; an invalid newer entry does not hide an older valid one
+ *   - config.mode is the fallback when the branch has no valid entry
+ *   - Branch independence: entries added after a fork do not affect other branches
+ */
+
+import assert from "node:assert/strict";
+import test from "node:test";
+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import { readModeFromBranch } from "../src/extension.js";
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+/** Append a raw custom entry directly, returning a full SessionManager. */
+function managerWith(...entries: Array<{ customType: string; data: unknown }>): SessionManager {
+  const mgr = SessionManager.inMemory("/test");
+  for (const e of entries) {
+    mgr.appendCustomEntry(e.customType, e.data);
+  }
+  return mgr;
+}
+
+// ---------------------------------------------------------------------------
+// Basic resolution
+// ---------------------------------------------------------------------------
+
+test("readModeFromBranch: returns undefined when branch has no custom entries", () => {
+  const mgr = SessionManager.inMemory("/test");
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: returns the mode from a single valid pij-mode entry", () => {
+  for (const mode of ["assist", "observe", "off"] as const) {
+    const mgr = managerWith({ customType: "pij-mode", data: { version: 1, mode } });
+    assert.equal(readModeFromBranch(mgr), mode, `failed for mode=${mode}`);
+  }
+});
+
+test("readModeFromBranch: picks the most recent valid entry (last in root-to-leaf order)", () => {
+  const mgr = SessionManager.inMemory("/test");
+  mgr.appendCustomEntry("pij-mode", { version: 1, mode: "assist" });
+  mgr.appendCustomEntry("pij-mode", { version: 1, mode: "off" });
+  assert.equal(readModeFromBranch(mgr), "off");
+});
+
+// ---------------------------------------------------------------------------
+// Invalid entry filtering
+// ---------------------------------------------------------------------------
+
+test("readModeFromBranch: ignores entries with a different customType", () => {
+  const mgr = managerWith(
+    { customType: "other-extension", data: { version: 1, mode: "off" } },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with an unsupported version", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: { version: 2, mode: "off" } },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with an unknown mode value", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: { version: 1, mode: "auto" } },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with additional data fields", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: { version: 1, mode: "off", extra: true } },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with missing mode field", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: { version: 1 } },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with missing version field", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: { mode: "off" } },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with null data", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: null },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with array data", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: [1, "off"] },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+test("readModeFromBranch: ignores entry with string data", () => {
+  const mgr = managerWith(
+    { customType: "pij-mode", data: "off" },
+  );
+  assert.equal(readModeFromBranch(mgr), undefined);
+});
+
+// ---------------------------------------------------------------------------
+// Invalid newer entries must not hide valid older entries
+// ---------------------------------------------------------------------------
+
+test("readModeFromBranch: skips invalid newer entry and finds valid older one", () => {
+  const mgr = SessionManager.inMemory("/test");
+  mgr.appendCustomEntry("pij-mode", { version: 1, mode: "observe" }); // valid – older
+  mgr.appendCustomEntry("pij-mode", { version: 99, mode: "off" });    // invalid – version 99
+  mgr.appendCustomEntry("pij-mode", { version: 1, mode: "assist", extra: "bad" }); // invalid – extra field
+  assert.equal(readModeFromBranch(mgr), "observe");
+});
+
+// ---------------------------------------------------------------------------
+// Branch independence
+// ---------------------------------------------------------------------------
+
+test("readModeFromBranch: entries on one branch do not affect another after branch()", () => {
+  const mgr = SessionManager.inMemory("/test");
+  const firstId = mgr.appendCustomEntry("pij-mode", { version: 1, mode: "off" }); // shared ancestor
+  // Fork: go back to the first entry and start a new branch
+  mgr.branch(firstId);
+  mgr.appendCustomEntry("pij-mode", { version: 1, mode: "assist" }); // on fork branch only
+
+  // Current leaf is now on the "assist" branch
+  assert.equal(readModeFromBranch(mgr), "assist");
+
+  // If we navigate back to firstId, only the shared ancestor entry is on the branch
+  mgr.branch(firstId);
+  assert.equal(readModeFromBranch(mgr), "off");
+});
