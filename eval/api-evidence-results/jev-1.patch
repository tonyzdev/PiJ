+/** Data shape stored in a pij-mode custom entry. */
+interface PijModeData {
+  version: 1;
+  mode: DecisionMode;
+}
+
+/** Validate and extract the mode from a raw pij-mode entry data field. */
+function parsePijModeData(data: unknown): DecisionMode | undefined {
+  if (typeof data !== "object" || data === null || Array.isArray(data)) return undefined;
+  const obj = data as Record<string, unknown>;
+  const keys = Object.keys(obj);
+  // Exactly two keys: version and mode — no additional fields allowed.
+  if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) return undefined;
+  if (obj["version"] !== 1) return undefined;
+  const m = obj["mode"];
+  if (m === "assist" || m === "observe" || m === "off") return m;
+  return undefined;
+}
+
+/**
+ * Walk the active branch (root → leaf) and return the most recent valid pij-mode
+ * entry's mode, or the provided default when no valid entry exists on this branch.
+ */
+function readModeFromBranch(entries: SessionEntry[], defaultMode: DecisionMode): DecisionMode {
+  for (let i = entries.length - 1; i >= 0; i--) {
+    const entry: SessionEntry | undefined = entries[i];
+    if (!entry || entry.type !== "custom" || (entry as CustomEntry).customType !== "pij-mode") continue;
+    const parsed = parsePijModeData((entry as CustomEntry<PijModeData>).data);
+    if (parsed !== undefined) return parsed;
+  }
+  return defaultMode;
+}
