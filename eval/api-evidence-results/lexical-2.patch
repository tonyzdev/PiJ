+const PIJ_MODE_CUSTOM_TYPE = "pij-mode";
+
+/**
+ * Extract the effective mode from a session branch.
+ * Walks entries from newest to oldest looking for the most recent valid pij-mode record.
+ * Invalid records (wrong version, extra fields, unknown mode) are skipped rather than
+ * blocking an older valid selection. Returns undefined when no valid record exists.
+ */
+function modeFromBranch(entries: SessionEntry[]): DecisionMode | undefined {
+  for (let i = entries.length - 1; i >= 0; i--) {
+    const entry = entries[i];
+    if (!entry || entry.type !== "custom") continue;
+    if (entry.customType !== PIJ_MODE_CUSTOM_TYPE) continue;
+    const d = entry.data;
+    if (!d || typeof d !== "object" || Array.isArray(d)) continue;
+    const data = d as Record<string, unknown>;
+    // Reject records with fields other than exactly {version, mode}
+    if (Object.keys(data).length !== 2) continue;
+    if (data["version"] !== 1) continue;
+    if (data["mode"] !== "assist" && data["mode"] !== "observe" && data["mode"] !== "off") continue;
+    return data["mode"] as DecisionMode;
+  }
+  return undefined;
+}
