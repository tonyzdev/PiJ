+/** Custom type identifier used for persisting mode selections in the session. */
+const PIJ_MODE_CUSTOM_TYPE = "pij-mode";
+
+/** Data stored in a pij-mode custom entry. */
+interface PijModeData {
+  version: 1;
+  mode: DecisionMode;
+}
+
+/**
+ * Walk the branch entries (root → leaf order, as returned by getBranch()) from
+ * newest to oldest and return the first valid pij-mode selection, or undefined
+ * when no valid entry exists on this branch.
+ *
+ * Validation rules:
+ * - entry.type === "custom" and entry.customType === PIJ_MODE_CUSTOM_TYPE
+ * - data must be a plain object with exactly the keys "version" and "mode"
+ * - version must be 1
+ * - mode must be "assist" | "observe" | "off"
+ * Invalid newer records are skipped so an older valid entry is still found.
+ */
+function readModeFromBranch(entries: SessionEntry[]): DecisionMode | undefined {
+  // getBranch() returns root → leaf; iterate reversed to check newest first.
+  for (let i = entries.length - 1; i >= 0; i--) {
+    const entry = entries[i];
+    if (!entry || entry.type !== "custom" || entry.customType !== PIJ_MODE_CUSTOM_TYPE) continue;
+    const d = entry.data;
+    if (d === null || d === undefined || typeof d !== "object" || Array.isArray(d)) continue;
+    const record = d as Record<string, unknown>;
+    const keys = Object.keys(record);
+    if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) continue;
+    if (record["version"] !== 1) continue;
+    const m = record["mode"];
+    if (m !== "assist" && m !== "observe" && m !== "off") continue;
+    return m;
+  }
+  return undefined;
+}
