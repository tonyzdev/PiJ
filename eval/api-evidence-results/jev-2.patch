index 0000000..97af59e
--- /dev/null
+++ b/src/session-mode.ts
@@ -0,0 +1,43 @@
+import type { SessionEntry } from "@earendil-works/pi-coding-agent";
+import type { DecisionMode } from "./config.js";
+
+/** Shape of a valid pij-mode custom entry's data payload. */
+export type PijModeData = { version: 1; mode: DecisionMode };
+
+/** The customType string used for pij-mode session entries. */
+export const PIJ_MODE_CUSTOM_TYPE = "pij-mode";
+
+/**
+ * Allowlist-only validation: version must be 1, mode must be a known value,
+ * data must contain exactly the two expected keys with no extras.
+ * Returns false for any malformed, over-specified, or unknown records.
+ */
+export function isValidModeData(data: unknown): data is PijModeData {
+  if (typeof data !== "object" || data === null) return false;
+  const keys = Object.keys(data as object);
+  if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) return false;
+  const d = data as Record<string, unknown>;
+  return d["version"] === 1 && (d["mode"] === "assist" || d["mode"] === "observe" || d["mode"] === "off");
+}
+
+/**
+ * Scan a session branch (root-first order) for the most recent valid pij-mode entry.
+ * Searches backward from the leaf so the newest valid record wins.
+ * Invalid entries (wrong customType, bad data, extra fields, unknown mode, unsupported
+ * version) are skipped and never hide an older valid entry.
+ * Falls back to defaultMode when no valid entry is found.
+ */
+export function readModeFromBranch(branch: SessionEntry[], defaultMode: DecisionMode): DecisionMode {
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const entry = branch[i];
+    if (
+      entry !== undefined &&
+      entry.type === "custom" &&
+      entry.customType === PIJ_MODE_CUSTOM_TYPE &&
+      isValidModeData(entry.data)
+    ) {
+      return (entry.data as PijModeData).mode;
+    }
+  }
+  return defaultMode;
+}
