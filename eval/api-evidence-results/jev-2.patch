index 0000000..c615471
--- /dev/null
+++ b/test/session-mode-persist.test.ts
@@ -0,0 +1,214 @@
+/**
+ * Tests for pij-mode session persistence.
+ *
+ * Covers:
+ *  - isValidModeData: allowlist-only validation (extra fields, bad version, unknown mode, non-objects)
+ *  - readModeFromBranch: most-recent-valid wins; invalid newer entries never hide older valid entries;
+ *    falls back to configured default on empty or all-invalid branches
+ *  - Integration: tree navigation restores the mode at the destination branch; config default is used
+ *    when the destination has no pij-mode entry; saved `off` overrides configured `assist` on reload
+ */
+
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { mkdir, mkdtemp, rm } from "node:fs/promises";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import type { SessionEntry } from "@earendil-works/pi-coding-agent";
+import { createAgentSession, DefaultResourceLoader, ModelRuntime, SessionManager, SettingsManager } from "@earendil-works/pi-coding-agent";
+import { loadConfig } from "../src/config.js";
+import { createPijExtension } from "../src/extension.js";
+import { isValidModeData, readModeFromBranch } from "../src/session-mode.js";
+
+// ---------------------------------------------------------------------------
+// Unit tests: isValidModeData
+// ---------------------------------------------------------------------------
+
+test("isValidModeData accepts exactly the three known modes at version 1", () => {
+  assert.ok(isValidModeData({ version: 1, mode: "assist" }));
+  assert.ok(isValidModeData({ version: 1, mode: "observe" }));
+  assert.ok(isValidModeData({ version: 1, mode: "off" }));
+});
+
+test("isValidModeData rejects unknown modes", () => {
+  assert.equal(isValidModeData({ version: 1, mode: "on" }), false);
+  assert.equal(isValidModeData({ version: 1, mode: "" }), false);
+  assert.equal(isValidModeData({ version: 1, mode: "ASSIST" }), false);
+});
+
+test("isValidModeData rejects unsupported versions", () => {
+  assert.equal(isValidModeData({ version: 2, mode: "assist" }), false);
+  assert.equal(isValidModeData({ version: 0, mode: "assist" }), false);
+  assert.equal(isValidModeData({ version: "1", mode: "assist" }), false);
+});
+
+test("isValidModeData rejects extra fields", () => {
+  assert.equal(isValidModeData({ version: 1, mode: "assist", extra: true }), false);
+  assert.equal(isValidModeData({ version: 1, mode: "off", timestamp: 0 }), false);
+});
+
+test("isValidModeData rejects missing fields", () => {
+  assert.equal(isValidModeData({ version: 1 }), false);
+  assert.equal(isValidModeData({ mode: "assist" }), false);
+  assert.equal(isValidModeData({}), false);
+});
+
+test("isValidModeData rejects non-object values", () => {
+  assert.equal(isValidModeData(null), false);
+  assert.equal(isValidModeData(undefined), false);
+  assert.equal(isValidModeData("assist"), false);
+  assert.equal(isValidModeData(42), false);
+  assert.equal(isValidModeData([{ version: 1, mode: "assist" }]), false);
+});
+
+// ---------------------------------------------------------------------------
+// Unit tests: readModeFromBranch
+// ---------------------------------------------------------------------------
+
+function makeCustomEntry(customType: string, data: unknown, id = "x"): SessionEntry {
+  return { type: "custom", customType, data, id, parentId: null, timestamp: new Date().toISOString() } as SessionEntry;
+}
+
+function makeMessageEntry(id = "m"): SessionEntry {
+  return { type: "message", id, parentId: null, timestamp: new Date().toISOString(), message: { role: "user", content: [] } } as unknown as SessionEntry;
+}
+
+test("readModeFromBranch returns defaultMode for an empty branch", () => {
+  assert.equal(readModeFromBranch([], "assist"), "assist");
+  assert.equal(readModeFromBranch([], "off"), "off");
+});
+
+test("readModeFromBranch returns defaultMode when no pij-mode entries exist", () => {
+  const branch: SessionEntry[] = [makeMessageEntry("a"), makeMessageEntry("b")];
+  assert.equal(readModeFromBranch(branch, "observe"), "observe");
+});
+
+test("readModeFromBranch returns mode from a single valid entry", () => {
+  const branch: SessionEntry[] = [makeCustomEntry("pij-mode", { version: 1, mode: "off" })];
+  assert.equal(readModeFromBranch(branch, "assist"), "off");
+});
+
+test("readModeFromBranch picks the most recent valid entry (last in branch order)", () => {
+  const branch: SessionEntry[] = [
+    makeCustomEntry("pij-mode", { version: 1, mode: "off" }, "first"),
+    makeCustomEntry("pij-mode", { version: 1, mode: "observe" }, "second"),
+  ];
+  assert.equal(readModeFromBranch(branch, "assist"), "observe");
+});
+
+test("readModeFromBranch skips invalid entries and finds the most recent valid one behind them", () => {
+  const branch: SessionEntry[] = [
+    makeCustomEntry("pij-mode", { version: 1, mode: "off" }, "valid"),
+    // Invalid: extra field
+    makeCustomEntry("pij-mode", { version: 1, mode: "assist", extra: true }, "invalid-extra"),
+    // Invalid: unknown mode
+    makeCustomEntry("pij-mode", { version: 1, mode: "unknown" }, "invalid-mode"),
+  ];
+  assert.equal(readModeFromBranch(branch, "assist"), "off");
+});
+
+test("readModeFromBranch ignores entries with a different customType", () => {
+  const branch: SessionEntry[] = [
+    makeCustomEntry("other-extension", { version: 1, mode: "observe" }),
+    makeCustomEntry("pij-mode", { version: 1, mode: "off" }),
+  ];
+  assert.equal(readModeFromBranch(branch, "assist"), "off");
+});
+
+test("readModeFromBranch: saved assist overrides configured off default", () => {
+  const branch: SessionEntry[] = [makeCustomEntry("pij-mode", { version: 1, mode: "assist" })];
+  assert.equal(readModeFromBranch(branch, "off"), "assist");
+});
+
+test("readModeFromBranch ignores malformed data (null, string, array)", () => {
+  const branch: SessionEntry[] = [
+    makeCustomEntry("pij-mode", null),
+    makeCustomEntry("pij-mode", "assist"),
+    makeCustomEntry("pij-mode", [{ version: 1, mode: "observe" }]),
+  ];
+  assert.equal(readModeFromBranch(branch, "off"), "off");
+});
+
+// ---------------------------------------------------------------------------
+// Integration: tree navigation and mode isolation
+// ---------------------------------------------------------------------------
+
+/** Create a minimal loopback model HTTP server and return cleanup + port helpers. */
+async function makeLoopbackServer(t: { after: (fn: () => Promise<void>) => void }) {
+  let callCount = 0;
+  const http = createServer(async (req, res) => {
+    for await (const _ of req) { /* drain */ }
+    callCount++;
+    res.writeHead(200, { "Content-Type": "text/event-stream" });
+    res.write(`data: ${JSON.stringify({ id: "l", object: "chat.completion.chunk", model: "fixture", choices: [{ index: 0, delta: { role: "assistant", content: "ok" }, finish_reason: null }] })}\n\n`);
+    res.write(`data: ${JSON.stringify({ id: "l", object: "chat.completion.chunk", model: "fixture", choices: [{ index: 0, delta: {}, finish_reason: "stop" }] })}\n\n`);
+    res.end("data: [DONE]\n\n");
+  });
+  http.listen(0, "127.0.0.1");
+  await once(http, "listening");
+  t.after(async () => {
+    http.closeAllConnections();
+    await new Promise<void>((r) => http.close(() => r()));
+  });
+  const addr = http.address();
+  assert.ok(addr && typeof addr === "object");
+  return { port: (addr as { port: number }).port, getCallCount: () => callCount };
+}
+
+test("tree navigation immediately restores mode at destination (ancestor with no selection yields config default)", { timeout: 15000 }, async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "pij-mode-tree-"));
+  const cwd = join(root, "project"), home = join(root, "agent");
+  await mkdir(cwd);
+  t.after(() => rm(root, { recursive: true, force: true }));
+
+  const { port } = await makeLoopbackServer(t);
+  const runtime = await ModelRuntime.create({ authPath: join(home, "auth.json"), modelsPath: null, refreshOnCreate: false });
+  runtime.registerProvider("tree-local", { baseUrl: `http://127.0.0.1:${port}/v1`, api: "openai-completions", apiKey: "local-fixture", models: [{ id: "fixture", name: "fixture", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32000, maxTokens: 128 }] });
+
+  const sessions: Awaited<ReturnType<typeof createAgentSession>>["session"][] = [];
+  const notices: string[] = [];
+  t.after(async () => { for (const s of sessions) { await s.abort(); s.dispose(); } });
+
+  async function open(manager: SessionManager) {
+    const settings = SettingsManager.inMemory({ retry: { enabled: false }, compaction: { enabled: false } });
+    const resources = new DefaultResourceLoader({ cwd, agentDir: home, settingsManager: settings, noExtensions: true, noSkills: true, noThemes: true, noPromptTemplates: true, agentsFilesOverride: () => ({ agentsFiles: [] }), skillsOverride: () => ({ skills: [], diagnostics: [] }), extensionFactories: [createPijExtension(loadConfig({ PIJ_HOME: home, PIJ_MODE: "assist" }))] });
+    await resources.reload();
+    assert.deepEqual(resources.getExtensions().errors, []);
+    const { session } = await createAgentSession({ cwd, agentDir: home, modelRuntime: runtime, model: runtime.getModel("tree-local", "fixture"), resourceLoader: resources, settingsManager: settings, sessionManager: manager, tools: [] });
+    sessions.push(session);
+    await session.bindExtensions({ uiContext: { ...session.extensionRunner.createContext().ui, notify: (msg: string) => notices.push(msg) } });
+    return session;
+  }
+
+  const session = await open(SessionManager.inMemory());
+
+  // Root state: default mode "assist", no pij-mode entry yet.
+  // Capture the leaf ID at the very start (before any user interaction).
+  const rootLeafId = session.sessionManager.getLeafId();
+  assert.ok(rootLeafId, "session must have a leaf before any messages");
+
+  // Switch to "off" and generate an assistant response so the tree diverges.
+  await session.prompt("/pij off");
+  await session.prompt("trigger a turn");   // generates an LLM response → new leaf
+
+  const offLeafId = session.sessionManager.getLeafId();
+
+  // Navigate back to the root (before mode was set). The branch at rootLeafId
+  // has no pij-mode entry, so the mode should revert to config default "assist".
+  await session.extensionRunner.createContext().sessionManager; // just ensure manager is accessible
+  const nav = await session.navigateTree(rootLeafId!);
+  assert.equal(nav.cancelled, false, "navigation must not be cancelled");
+
+  // Ask for status — mode should be the config default "assist" because the
+  // ancestor branch carries no pij-mode entry.
+  await session.prompt("/pij status");
+  assert.match(notices.at(-1)!, /Mode: assist\b/, "navigating to ancestor with no entry must restore config default");
+
+  // Navigate forward to the off leaf and check mode is restored to "off".
+  const nav2 = await session.navigateTree(offLeafId!);
+  assert.equal(nav2.cancelled, false);
+  await session.prompt("/pij status");
+  assert.match(notices.at(-1)!, /Mode: off\b/, "navigating to off branch must restore off");
+});
