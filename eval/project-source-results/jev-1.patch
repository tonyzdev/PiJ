+/**
+ * Tests for PiJ mode persistence using Pi session custom entries.
+ *
+ * Covers:
+ *  - parsePijModeEntry validation (allowlist rules, version, mode values, extra fields)
+ *  - Extension restores mode from the active branch on session_start
+ *  - Extension falls back to config.mode when the branch has no valid entry
+ *  - Invalid entries newer than a valid one do not hide the valid selection
+ *  - Mode is recorded as a custom entry (not a model-context message)
+ */
+
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { mkdir, mkdtemp, rm } from "node:fs/promises";
