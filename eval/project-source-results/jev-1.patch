+/** Custom entry type for persisting the active PiJ mode in the Pi session. */
+export const PIJ_MODE_CUSTOM_TYPE = "pij-mode";
+
+/**
+ * Validate and extract the DecisionMode from a session entry.
+ * Returns null for any entry that is not a well-formed pij-mode record:
+ * wrong type, wrong customType, missing/extra fields, unknown mode, or
+ * unsupported version.
+ *
+ * Exported for unit testing only; the public contract is the extension
+ * behavior documented in README.md.
+ */
+export function parsePijModeEntry(entry: SessionEntry): DecisionMode | null {
+  if (entry.type !== "custom" || entry.customType !== PIJ_MODE_CUSTOM_TYPE) return null;
+  const data = entry.data;
+  if (!data || typeof data !== "object" || Array.isArray(data)) return null;
+  const d = data as Record<string, unknown>;
+  const keys = Object.keys(d);
+  // Allowlist: exactly { version, mode } – no additional fields.
+  if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) return null;
+  if (d["version"] !== 1) return null;
+  if (d["mode"] !== "assist" && d["mode"] !== "observe" && d["mode"] !== "off") return null;
+  return d["mode"] as DecisionMode;
+}
+
+/**
+ * Walk the active branch backward (newest → oldest) and return the mode
+ * recorded in the most recent valid pij-mode entry, or config.mode when the
+ * branch contains no valid entry.
+ */
+function restoreModeFromBranch(ctx: ExtensionContext, config: PijConfig): DecisionMode {
+  const branch = ctx.sessionManager.getBranch();
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const entry = branch[i];
+    if (!entry) continue;
+    const parsed = parsePijModeEntry(entry);
+    if (parsed !== null) return parsed;
+  }
+  return config.mode;
+}
