+  createAgentSession,
+  DefaultResourceLoader,
+  ModelRuntime,
+  SessionManager,
+  SettingsManager,
+} from "@earendil-works/pi-coding-agent";
+import { parsePijModeEntry, PIJ_MODE_CUSTOM_TYPE } from "../src/extension.js";
+import { loadConfig } from "../src/config.js";
+import { createPijExtension } from "../src/extension.js";
+
+// ---------------------------------------------------------------------------
+// Unit tests for parsePijModeEntry
+// ---------------------------------------------------------------------------
+
+test("parsePijModeEntry: accepts valid version-1 entries for all three modes", () => {
+  const base = { id: "a1b2c3d4", parentId: null, timestamp: new Date().toISOString() };
+  for (const mode of ["assist", "observe", "off"] as const) {
+    const entry = { ...base, type: "custom" as const, customType: PIJ_MODE_CUSTOM_TYPE, data: { version: 1, mode } };
+    assert.equal(parsePijModeEntry(entry), mode);
+  }
+});
+
+test("parsePijModeEntry: returns null for wrong entry type", () => {
+  const base = { id: "a1b2c3d4", parentId: null, timestamp: new Date().toISOString() };
+  // A message entry (not "custom") must always return null.
+  const entry = {
+    ...base,
+    type: "message" as const,
+    // Include a message payload to satisfy the SessionMessageEntry shape.
+    message: { role: "user" as const, content: "hi", timestamp: Date.now() },
+  };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: returns null for wrong customType", () => {
+  const base = { id: "a1b2c3d4", parentId: null, timestamp: new Date().toISOString() };
+  const entry = {
+    ...base,
+    type: "custom" as const,
+    customType: "other-extension",
+    data: { version: 1, mode: "assist" },
+  };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: returns null for unknown mode string", () => {
+  const base = { id: "a1b2c3d4", parentId: null, timestamp: new Date().toISOString() };
+  const entry = {
+    ...base,
+    type: "custom" as const,
+    customType: PIJ_MODE_CUSTOM_TYPE,
+    data: { version: 1, mode: "turbo" },
+  };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: returns null for unsupported version", () => {
+  const base = { id: "a1b2c3d4", parentId: null, timestamp: new Date().toISOString() };
+  const entry = {
+    ...base,
+    type: "custom" as const,
+    customType: PIJ_MODE_CUSTOM_TYPE,
+    data: { version: 2, mode: "assist" },
