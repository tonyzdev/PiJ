+// ---------------------------------------------------------------------------
+// Integration tests: mode persistence through the extension lifecycle
+// ---------------------------------------------------------------------------
+
+/**
+ * Create a minimal loopback HTTP model server that returns one "done" response.
+ * Returns {baseUrl, close, requestCount}.
+ */
+async function startLoopbackModel(t: TestContext) {
+  let requests = 0;
+  const http = createServer(async (req, res) => {
+    for await (const _ of req) { /* drain */ }
+    requests++;
+    res.writeHead(200, { "Content-Type": "text/event-stream" });
+    const done = { id: "x", object: "chat.completion.chunk", model: "fixture", choices: [{ index: 0, delta: { role: "assistant", content: "ok" }, finish_reason: null }] };
+    const stop = { id: "x", object: "chat.completion.chunk", model: "fixture", choices: [{ index: 0, delta: {}, finish_reason: "stop" }] };
+    res.write(`data: ${JSON.stringify(done)}\n\ndata: ${JSON.stringify(stop)}\n\n`);
+    res.end("data: [DONE]\n\n");
+  });
+  http.listen(0, "127.0.0.1");
+  await once(http, "listening");
+  t.after(() => { http.closeAllConnections(); http.close(); });
+  const addr = http.address();
+  assert.ok(addr && typeof addr === "object");
+  const baseUrl = `http://127.0.0.1:${addr.port}/v1`;
+  return { baseUrl, get requests() { return requests; } };
+}
+
+async function openSession(
+  home: string,
+  cwd: string,
+  runtime: ModelRuntime,
+  manager: SessionManager,
+  configMode: "assist" | "observe" | "off",
+  sessions: Awaited<ReturnType<typeof createAgentSession>>["session"][],
+  notices: string[],
+) {
+  const config = loadConfig({ PIJ_HOME: home, PIJ_MODE: configMode });
+  const settings = SettingsManager.inMemory({ retry: { enabled: false }, compaction: { enabled: false } });
+  const resources = new DefaultResourceLoader({
+    cwd, agentDir: home, settingsManager: settings,
+    noExtensions: true, noSkills: true, noThemes: true, noPromptTemplates: true,
+    agentsFilesOverride: () => ({ agentsFiles: [] }),
+    skillsOverride: () => ({ skills: [], diagnostics: [] }),
+    extensionFactories: [createPijExtension(config)],
+  });
+  await resources.reload();
+  assert.deepEqual(resources.getExtensions().errors, []);
+  const { session } = await createAgentSession({
+    cwd, agentDir: home,
+    modelRuntime: runtime,
+    model: runtime.getModel("mp-fixture", "fixture"),
+    resourceLoader: resources,
+    settingsManager: settings,
+    sessionManager: manager,
+    tools: [],
+  });
+  sessions.push(session);
+  await session.bindExtensions({
+    uiContext: { ...session.extensionRunner.createContext().ui, notify: (m) => notices.push(m) },
+  });
+  return session;
+}
+
+test("extension restores the mode saved in a prior session on reopen", { timeout: 10000 }, async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "pij-mp-reopen-"));
+  const cwd = join(root, "project"), home = join(root, "agent");
+  await mkdir(cwd);
+  const sessions: Awaited<ReturnType<typeof createAgentSession>>["session"][] = [];
+  const notices: string[] = [];
+  t.after(async () => {
+    for (const s of sessions) { await s.abort(); s.dispose(); }
+    await rm(root, { recursive: true, force: true });
+  });
+
+  const { baseUrl } = await startLoopbackModel(t);
+  const runtime = await ModelRuntime.create({ authPath: join(home, "auth.json"), modelsPath: null, refreshOnCreate: false });
+  runtime.registerProvider("mp-fixture", { baseUrl, api: "openai-completions", apiKey: "x", models: [{ id: "fixture", name: "fixture", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32000, maxTokens: 128 }] });
+
+  // Open with assist configured; switch to observe; trigger a save.
+  const first = await openSession(home, cwd, runtime, SessionManager.create(cwd, join(root, "sessions")), "assist", sessions, notices);
+  await first.prompt("/pij observe");
+  await first.prompt("trigger save");
+  const path = first.sessionFile;
+  assert.ok(path, "session must be saved to disk after a model response");
+  first.dispose();
+
+  // Reopen with assist configured; the persisted observe entry must win.
+  const second = await openSession(home, cwd, runtime, SessionManager.open(path), "assist", sessions, notices);
+  await second.prompt("/pij status");
+  assert.match(notices.at(-1)!, /Mode: observe\b/, "reopened session must restore observe, not the configured assist");
+});
+
+test("extension falls back to config.mode when the branch has no pij-mode entry", { timeout: 10000 }, async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "pij-mp-fallback-"));
+  const cwd = join(root, "project"), home = join(root, "agent");
+  await mkdir(cwd);
+  const sessions: Awaited<ReturnType<typeof createAgentSession>>["session"][] = [];
+  const notices: string[] = [];
+  t.after(async () => {
+    for (const s of sessions) { await s.abort(); s.dispose(); }
+    await rm(root, { recursive: true, force: true });
+  });
+
+  const { baseUrl } = await startLoopbackModel(t);
+  const runtime = await ModelRuntime.create({ authPath: join(home, "auth.json"), modelsPath: null, refreshOnCreate: false });
+  runtime.registerProvider("mp-fixture", { baseUrl, api: "openai-completions", apiKey: "x", models: [{ id: "fixture", name: "fixture", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32000, maxTokens: 128 }] });
+
+  // New in-memory session with off configured, no mode command issued.
+  const session = await openSession(home, cwd, runtime, SessionManager.inMemory(), "off", sessions, notices);
