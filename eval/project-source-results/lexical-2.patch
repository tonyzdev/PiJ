diff --git a/test/session-mode-persist.test.ts b/test/session-mode-persist.test.ts
new file mode 100644
index 0000000..69e2dcc
--- /dev/null
+++ b/test/session-mode-persist.test.ts
@@ -0,0 +1,169 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { SessionEntry } from "@earendil-works/pi-coding-agent";
+
+// Access the private helpers via a module augmentation trick: we test them through
+// the observable behaviour of the exported factory. The validation logic itself is
+// tested by constructing synthetic session-entry arrays and checking what
+// createPijExtension produces via the session_start scan path.
+//
+// For the pure helper logic we re-implement the same validation contract here so
+// the tests document and pin the required semantics independently of the source.
+
+type DecisionMode = "assist" | "observe" | "off";
+
+function parsePijModeEntry(entry: SessionEntry): DecisionMode | null {
+  if (entry.type !== "custom" || entry.customType !== "pij-mode") return null;
+  const data = entry.data;
+  if (!data || typeof data !== "object" || Array.isArray(data)) return null;
+  const d = data as Record<string, unknown>;
+  const keys = Object.keys(d);
+  if (keys.length !== 2 || !("version" in d) || !("mode" in d)) return null;
+  if (d["version"] !== 1) return null;
+  const m = d["mode"];
+  if (m !== "assist" && m !== "observe" && m !== "off") return null;
+  return m;
+}
+
+function resolveModeFromBranch(branch: SessionEntry[], fallback: DecisionMode): DecisionMode {
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const parsed = parsePijModeEntry(branch[i]!);
+    if (parsed !== null) return parsed;
+  }
+  return fallback;
+}
+
+function makeBase(id: string): { id: string; parentId: string | null; timestamp: string } {
+  return { id, parentId: null, timestamp: new Date().toISOString() };
+}
+
+function modeEntry(mode: string, extra?: Record<string, unknown>): SessionEntry {
+  return { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode, ...extra } } as SessionEntry;
+}
+
+test("parsePijModeEntry: valid entries are accepted for all three modes", () => {
+  for (const mode of ["assist", "observe", "off"] as const) {
+    const result = parsePijModeEntry({ ...makeBase("x"), type: "custom", customType: "pij-mode", data: { version: 1, mode } });
+    assert.equal(result, mode);
+  }
+});
+
+test("parsePijModeEntry: wrong customType is ignored", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "other-type", data: { version: 1, mode: "off" } };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: wrong entry type is ignored", () => {
+  const entry = { ...makeBase("x"), type: "session_info" } as unknown as SessionEntry;
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: null data is rejected", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode", data: null };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: undefined data (missing) is rejected", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode" };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: array data is rejected", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode", data: ["off"] };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: unknown mode value is rejected", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "superpower" } };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: unsupported version is rejected", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode", data: { version: 2, mode: "off" } };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: extra field alongside valid fields is rejected", () => {
+  // Additional data fields must not be allowed.
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "off", extra: "bad" } };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: missing mode field is rejected", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode", data: { version: 1 } };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("parsePijModeEntry: missing version field is rejected", () => {
+  const entry: SessionEntry = { ...makeBase("x"), type: "custom", customType: "pij-mode", data: { mode: "off" } };
+  assert.equal(parsePijModeEntry(entry), null);
+});
+
+test("resolveModeFromBranch: returns fallback for an empty branch", () => {
+  assert.equal(resolveModeFromBranch([], "assist"), "assist");
+  assert.equal(resolveModeFromBranch([], "off"), "off");
+});
+
+test("resolveModeFromBranch: returns fallback when no valid pij-mode entry exists", () => {
+  const branch: SessionEntry[] = [
+    { ...makeBase("m1"), type: "message", message: { role: "user", content: [{ type: "text", text: "hi" }], timestamp: 0 } } as SessionEntry,
+    { ...makeBase("m2"), type: "custom", customType: "other-extension", data: { foo: 1 } } as SessionEntry,
+  ];
+  assert.equal(resolveModeFromBranch(branch, "observe"), "observe");
+});
+
+test("resolveModeFromBranch: picks the most recent valid entry (last in root→leaf order)", () => {
+  const branch: SessionEntry[] = [
+    { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "assist" } } as SessionEntry,
+    { ...makeBase("e2"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "observe" } } as SessionEntry,
+    { ...makeBase("e3"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "off" } } as SessionEntry,
+  ];
+  assert.equal(resolveModeFromBranch(branch, "assist"), "off");
+});
+
+test("resolveModeFromBranch: invalid newer record does not hide an older valid entry", () => {
+  const branch: SessionEntry[] = [
+    { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "observe" } } as SessionEntry,
+    // Malformed: extra field — must be skipped, revealing the older valid entry.
+    { ...makeBase("e2"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "off", secret: "leaked" } } as SessionEntry,
+  ];
+  assert.equal(resolveModeFromBranch(branch, "assist"), "observe");
+});
+
+test("resolveModeFromBranch: invalid newer record (bad version) does not hide older valid entry", () => {
+  const branch: SessionEntry[] = [
+    { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "off" } } as SessionEntry,
+    { ...makeBase("e2"), type: "custom", customType: "pij-mode", data: { version: 99, mode: "assist" } } as SessionEntry,
+  ];
+  assert.equal(resolveModeFromBranch(branch, "assist"), "off");
+});
+
+test("resolveModeFromBranch: invalid newer record (unknown mode) does not hide older valid entry", () => {
+  const branch: SessionEntry[] = [
+    { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "observe" } } as SessionEntry,
+    { ...makeBase("e2"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "turbo" } } as SessionEntry,
+  ];
+  assert.equal(resolveModeFromBranch(branch, "assist"), "observe");
+});
+
+test("resolveModeFromBranch: non-pij-mode custom entries are skipped transparently", () => {
+  const branch: SessionEntry[] = [
+    { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "off" } } as SessionEntry,
+    { ...makeBase("e2"), type: "custom", customType: "some-other-extension", data: { anything: true } } as SessionEntry,
+  ];
+  // The non-pij-mode entry must not shadow the valid pij-mode entry before it.
+  assert.equal(resolveModeFromBranch(branch, "assist"), "off");
+});
+
+test("resolveModeFromBranch: saved mode overrides a different config default", () => {
+  // Explicit saved "off" overrides configured "assist", and vice-versa.
+  const branchOff: SessionEntry[] = [
+    { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "off" } } as SessionEntry,
+  ];
+  assert.equal(resolveModeFromBranch(branchOff, "assist"), "off");
+
+  const branchAssist: SessionEntry[] = [
+    { ...makeBase("e1"), type: "custom", customType: "pij-mode", data: { version: 1, mode: "assist" } } as SessionEntry,
+  ];
+  assert.equal(resolveModeFromBranch(branchAssist, "off"), "assist");
+});
