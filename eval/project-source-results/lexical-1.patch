+/** Valid pij-mode custom entry data shape. */
+interface PijModeData {
+  version: 1;
+  mode: DecisionMode;
+}
+
+/**
+ * Validate and extract a pij-mode data record.
+ * Returns the DecisionMode if the entry is a valid, well-formed pij-mode custom entry;
+ * returns undefined if the entry is invalid, has unknown fields, unsupported version, or unknown mode.
+ */
+function parsePijModeEntry(entry: CustomEntry): DecisionMode | undefined {
+  const d = entry.data;
+  if (d === null || typeof d !== "object" || Array.isArray(d)) return undefined;
+  const data = d as Record<string, unknown>;
+  // Reject entries with extra fields beyond version and mode.
+  const keys = Object.keys(data);
+  if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) return undefined;
+  if (data["version"] !== 1) return undefined;
+  const m = data["mode"];
+  if (m !== "assist" && m !== "observe" && m !== "off") return undefined;
+  return m;
+}
+
+/**
+ * Walk the active branch from the most-recent entry toward the root and return
+ * the DecisionMode from the most recent valid pij-mode custom entry, or undefined
+ * when the branch has no valid selection.
+ */
+function loadModeFromBranch(sessionManager: ExtensionContext["sessionManager"], leafId?: string | null): DecisionMode | undefined {
+  // getBranch() returns root-to-leaf order; iterate in reverse for most-recent first.
+  const branch = sessionManager.getBranch(leafId ?? undefined);
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const entry = branch[i]!;
+    if (entry.type !== "custom" || entry.customType !== "pij-mode") continue;
+    const mode = parsePijModeEntry(entry as CustomEntry);
+    if (mode !== undefined) return mode;
+  }
+  return undefined;
+}
