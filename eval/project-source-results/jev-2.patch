+/**
+ * Walk the active branch entries (root-to-leaf order from getBranch) backward
+ * to find the most recent valid pij-mode custom entry. Returns the stored mode
+ * or undefined when no valid entry exists on this branch.
+ *
+ * Validation rules (all must hold; any failure skips the entry):
+ * - type === "custom" and customType === "pij-mode"
+ * - data is a plain object (not null, not array)
+ * - data has exactly two keys: "version" and "mode"
+ * - data.version === 1
+ * - data.mode is one of "assist" | "observe" | "off"
+ */
+export function readModeFromBranch(branch: SessionEntry[]): DecisionMode | undefined {
+  for (let i = branch.length - 1; i >= 0; i--) {
+    const entry = branch[i];
+    if (!entry || entry.type !== "custom" || entry.customType !== "pij-mode") continue;
+    const d = entry.data;
+    if (!d || typeof d !== "object" || Array.isArray(d)) continue;
+    const data = d as Record<string, unknown>;
+    const keys = Object.keys(data);
+    if (keys.length !== 2 || !Object.prototype.hasOwnProperty.call(data, "version") || !Object.prototype.hasOwnProperty.call(data, "mode")) continue;
+    if (data["version"] !== 1) continue;
+    if (data["mode"] !== "assist" && data["mode"] !== "observe" && data["mode"] !== "off") continue;
+    return data["mode"] as DecisionMode;
+  }
+  return undefined;
+}
