diff --git a/test/session-persistence.test.ts b/test/session-persistence.test.ts
new file mode 100644
index 0000000..5c1eca2
--- /dev/null
+++ b/test/session-persistence.test.ts
@@ -0,0 +1,271 @@
+/**
+ * Unit tests for readModeFromBranch and session-native mode persistence.
+ *
+ * These tests cover:
+ * - readModeFromBranch validation rules (all must hold for a valid entry)
+ * - Fallback to config.mode when no valid entry exists
+ * - Most-recent-wins: later entries shadow earlier ones; invalid newer entries
+ *   do not hide an older valid selection
+ * - mode command writes a custom entry that survives session reopen
+ */
+
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { mkdir, mkdtemp, rm } from "node:fs/promises";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+
+import {
+  createAgentSession,
+  DefaultResourceLoader,
+  ModelRuntime,
+  SessionManager,
+  SettingsManager,
+  type SessionEntry,
+} from "@earendil-works/pi-coding-agent";
+
+import { loadConfig } from "../src/config.js";
+import { createPijExtension, readModeFromBranch } from "../src/extension.js";
+
+// ---------------------------------------------------------------------------
+// Pure unit tests for readModeFromBranch
+// ---------------------------------------------------------------------------
+
+function makeCustomEntry(customType: string, data: unknown): SessionEntry {
+  return {
+    type: "custom",
+    id: Math.random().toString(16).slice(2, 10),
+    parentId: null,
+    timestamp: new Date().toISOString(),
+    customType,
+    data,
+  };
+}
+
+test("readModeFromBranch: returns undefined for empty branch", () => {
+  assert.equal(readModeFromBranch([]), undefined);
+});
+
+test("readModeFromBranch: returns undefined when no pij-mode entry exists", () => {
+  const entry = makeCustomEntry("other-extension", { version: 1, mode: "off" });
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: returns mode from a valid assist entry", () => {
+  const entry = makeCustomEntry("pij-mode", { version: 1, mode: "assist" });
+  assert.equal(readModeFromBranch([entry]), "assist");
+});
+
+test("readModeFromBranch: returns mode from a valid observe entry", () => {
+  const entry = makeCustomEntry("pij-mode", { version: 1, mode: "observe" });
+  assert.equal(readModeFromBranch([entry]), "observe");
+});
+
+test("readModeFromBranch: returns mode from a valid off entry", () => {
+  const entry = makeCustomEntry("pij-mode", { version: 1, mode: "off" });
+  assert.equal(readModeFromBranch([entry]), "off");
+});
+
+test("readModeFromBranch: most recent valid entry wins (later index)", () => {
+  const older = makeCustomEntry("pij-mode", { version: 1, mode: "assist" });
+  const newer = makeCustomEntry("pij-mode", { version: 1, mode: "off" });
+  assert.equal(readModeFromBranch([older, newer]), "off");
+});
+
+test("readModeFromBranch: invalid newer entry does not hide older valid entry", () => {
+  const valid = makeCustomEntry("pij-mode", { version: 1, mode: "observe" });
+  // newer but invalid: unknown mode
+  const invalid = makeCustomEntry("pij-mode", { version: 1, mode: "unknown" });
+  assert.equal(readModeFromBranch([valid, invalid]), "observe");
+});
+
+test("readModeFromBranch: ignores entry with unknown mode string", () => {
+  const entry = makeCustomEntry("pij-mode", { version: 1, mode: "turbo" });
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with unsupported version", () => {
+  const entry = makeCustomEntry("pij-mode", { version: 2, mode: "assist" });
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with additional data fields", () => {
+  const entry = makeCustomEntry("pij-mode", { version: 1, mode: "assist", extra: "bad" });
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with null data", () => {
+  const entry = makeCustomEntry("pij-mode", null);
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with array data", () => {
+  const entry = makeCustomEntry("pij-mode", [1, 2, 3]);
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with string data", () => {
+  const entry = makeCustomEntry("pij-mode", "off");
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with missing mode field", () => {
+  const entry = makeCustomEntry("pij-mode", { version: 1 });
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with missing version field", () => {
+  const entry = makeCustomEntry("pij-mode", { mode: "assist" });
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores entry with wrong customType", () => {
+  const entry = makeCustomEntry("pij-mode-v2", { version: 1, mode: "off" });
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: ignores non-custom entry types with matching data", () => {
+  // A message entry should never be treated as a mode record
+  const entry: SessionEntry = {
+    type: "session_info",
+    id: "abc12345",
+    parentId: null,
+    timestamp: new Date().toISOString(),
+    name: undefined,
+  };
+  assert.equal(readModeFromBranch([entry]), undefined);
+});
+
+test("readModeFromBranch: skips invalid intermediate entries to find older valid one", () => {
+  const valid = makeCustomEntry("pij-mode", { version: 1, mode: "assist" });
+  const badVersion = makeCustomEntry("pij-mode", { version: 99, mode: "off" });
+  const badMode = makeCustomEntry("pij-mode", { version: 1, mode: "nope" });
+  const extraField = makeCustomEntry("pij-mode", { version: 1, mode: "off", foo: "bar" });
+  assert.equal(readModeFromBranch([valid, badVersion, badMode, extraField]), "assist");
+});
+
+// ---------------------------------------------------------------------------
+// Integration test: mode selection persists across session reopen
+// ---------------------------------------------------------------------------
+
+test("mode selection is written and restored when a saved session is reopened", { timeout: 15000 }, async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "pij-persist-"));
+  const cwd = join(root, "project");
+  const home = join(root, "agent");
+  await mkdir(cwd);
+
+  const sessions: Awaited<ReturnType<typeof createAgentSession>>["session"][] = [];
+  let requests = 0;
+
+  const http = createServer(async (req, res) => {
+    for await (const _ of req) { /* drain */ }
+    requests++;
+    res.writeHead(200, { "Content-Type": "text/event-stream" });
+    res.write(`data: ${JSON.stringify({ id: "x", object: "chat.completion.chunk", model: "fixture", choices: [{ index: 0, delta: { role: "assistant", content: "OK." }, finish_reason: null }] })}\n\n`);
+    res.write(`data: ${JSON.stringify({ id: "x", object: "chat.completion.chunk", model: "fixture", choices: [{ index: 0, delta: {}, finish_reason: "stop" }] })}\n\n`);
+    res.end("data: [DONE]\n\n");
+  });
+
+  t.after(async () => {
+    for (const s of sessions) { await s.abort(); s.dispose(); }
+    http.closeAllConnections();
+    await new Promise<void>((resolve) => http.close(() => resolve()));
+    await rm(root, { recursive: true, force: true });
+  });
+
+  http.listen(0, "127.0.0.1");
+  await once(http, "listening");
+  const addr = http.address();
+  assert.ok(addr && typeof addr === "object");
+
+  const runtime = await ModelRuntime.create({ authPath: join(home, "auth.json"), modelsPath: null, refreshOnCreate: false });
+  runtime.registerProvider("persist-local", {
+    baseUrl: `http://127.0.0.1:${addr.port}/v1`,
+    api: "openai-completions",
+    apiKey: "local",
+    models: [{ id: "fixture", name: "fixture", reasoning: false, input: ["text"], cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, contextWindow: 32000, maxTokens: 128 }],
+  });
+
+  const notices: string[] = [];
+
+  async function openSession(manager: SessionManager) {
+    const settings = SettingsManager.inMemory({ retry: { enabled: false }, compaction: { enabled: false } });
+    const resources = new DefaultResourceLoader({
+      cwd, agentDir: home, settingsManager: settings,
+      noExtensions: true, noSkills: true, noThemes: true, noPromptTemplates: true,
+      agentsFilesOverride: () => ({ agentsFiles: [] }),
+      skillsOverride: () => ({ skills: [], diagnostics: [] }),
+      extensionFactories: [createPijExtension(loadConfig({ PIJ_HOME: home, PIJ_MODE: "assist" }))],
+    });
+    await resources.reload();
+    assert.deepEqual(resources.getExtensions().errors, []);
+    const { session } = await createAgentSession({
+      cwd, agentDir: home,
+      modelRuntime: runtime,
+      model: runtime.getModel("persist-local", "fixture"),
+      resourceLoader: resources,
+      settingsManager: settings,
+      sessionManager: manager,
+      tools: [],
+    });
+    sessions.push(session);
+    await session.bindExtensions({
+      uiContext: { ...session.extensionRunner.createContext().ui, notify: (msg) => notices.push(msg) },
+    });
+    return session;
+  }
+
+  // --- First session: set mode to "observe" then trigger save via prompt ---
+  const first = await openSession(SessionManager.create(cwd, join(root, "sessions")));
+  await first.prompt("/pij observe");
+  await first.prompt("Trigger model save.");
+  const path = first.sessionFile;
+  assert.ok(path, "session must be saved after model response");
+  first.dispose();
+
+  // --- Reopen: mode should restore to "observe", not fall back to "assist" ---
+  notices.length = 0;
+  const second = await openSession(SessionManager.open(path));
+  await second.prompt("/pij status");
+  const statusNotice = notices.at(-1) ?? "";
+  assert.match(statusNotice, /Mode: observe\b/, "reopened session must restore observe");
+  assert.equal(requests, 1, "commands do not invoke the model");
+});
+
+test("mode falls back to config when session has no pij-mode entry", { timeout: 10000 }, async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "pij-fallback-"));
+  const cwd = join(root, "project");
+  const home = join(root, "agent");
+  await mkdir(cwd);
+
+  t.after(() => rm(root, { recursive: true, force: true }));
+
+  const runtime = await ModelRuntime.create({ authPath: join(home, "auth.json"), modelsPath: null, refreshOnCreate: false });
+  const notices: string[] = [];
+  const settings = SettingsManager.inMemory({ retry: { enabled: false }, compaction: { enabled: false } });
+  const resources = new DefaultResourceLoader({
+    cwd, agentDir: home, settingsManager: settings,
+    noExtensions: true, noSkills: true, noThemes: true, noPromptTemplates: true,
+    agentsFilesOverride: () => ({ agentsFiles: [] }),
+    skillsOverride: () => ({ skills: [], diagnostics: [] }),
+    // Config default is "off"
+    extensionFactories: [createPijExtension(loadConfig({ PIJ_HOME: home, PIJ_MODE: "off" }))],
+  });
+  await resources.reload();
+
+  const { session } = await createAgentSession({
+    cwd, agentDir: home, modelRuntime: runtime,
+    resourceLoader: resources, settingsManager: settings,
+    sessionManager: SessionManager.inMemory(), tools: [],
+  });
+  t.after(() => session.dispose());
+  await session.bindExtensions({
+    uiContext: { ...session.extensionRunner.createContext().ui, notify: (msg) => notices.push(msg) },
+  });
+
+  await session.prompt("/pij status");
+  const statusNotice = notices.at(-1) ?? "";
+  assert.match(statusNotice, /Mode: off\b/, "without a pij-mode entry, mode is config default");
+});
