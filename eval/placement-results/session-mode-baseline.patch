+/** Allowlisted, bounded structure stored per mode change. No prompts, excerpts, or credentials. */
+const PIJ_MODE_CUSTOM_TYPE = "pij-mode" as const;
+interface PijModeData { version: 1; mode: DecisionMode; }
+
+/**
+ * Validates that an unknown value is a well-formed pij-mode data record.
+ * Rejects extra fields, unknown versions, unknown modes, and non-objects.
+ */
+export function isValidPijModeData(data: unknown): data is PijModeData {
+  if (data === null || typeof data !== "object") return false;
+  const d = data as Record<string, unknown>;
+  const keys = Object.keys(d);
+  if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) return false;
+  if (d["version"] !== 1) return false;
+  return d["mode"] === "assist" || d["mode"] === "observe" || d["mode"] === "off";
+}
