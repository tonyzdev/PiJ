+/**
+ * Parse `data` from a custom entry of type "pij-mode".
+ * Returns the mode if data is exactly `{ version: 1, mode: <valid> }` with no extra fields.
+ * Returns undefined for any malformed, unknown, or versioned-out data.
+ * Exported for testing only.
+ */
+export function parsePijModeData(data: unknown): DecisionMode | undefined {
+  if (typeof data !== "object" || data === null || Array.isArray(data)) return undefined;
+  const keys = Object.keys(data as object);
+  if (keys.length !== 2 || !keys.includes("version") || !keys.includes("mode")) return undefined;
+  const d = data as Record<string, unknown>;
+  if (d.version !== 1) return undefined;
+  if (d.mode !== "assist" && d.mode !== "observe" && d.mode !== "off") return undefined;
+  return d.mode;
+}
+
+/**
+ * Scan the given branch entries (in any order) for the most recent valid "pij-mode" custom entry.
+ * Returns the persisted mode, or undefined when no valid record is on the branch.
+ * Invalid records (wrong type, bad version, extra fields, unknown mode) are skipped.
+ * Exported for testing only.
+ */
+export function readModeFromBranch(entries: SessionEntry[]): DecisionMode | undefined {
+  // Entries are returned in root-to-leaf (chronological) order by getBranch().
+  // Iterate in reverse so the first match is the one closest to the leaf (most recent).
+  for (let i = entries.length - 1; i >= 0; i--) {
+    const entry = entries[i];
+    if (!entry || entry.type !== "custom" || entry.customType !== "pij-mode") continue;
+    const parsed = parsePijModeData(entry.data);
+    if (parsed !== undefined) return parsed;
+    // Invalid record: skip and continue searching further back.
+  }
+  return undefined;
+}
