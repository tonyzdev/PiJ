# Copy to .env and start with: node --env-file=.env bin/pij.mjs
# Or use /login inside PiJ for your coding model.
TYPESAFE_API_KEY=
# Alternatively choose Vercel AI Gateway:
# PIJ_JEV_PROVIDER=vercel
# AI_GATEWAY_API_KEY=
PIJ_MODE=assist
# Defaults to jev-latest for TypeSafe, typesafe-ai/jev for Vercel.
# PIJ_JEV_MODEL=
PIJ_JEV_TIMEOUT_MS=1800
